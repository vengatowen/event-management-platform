# ============================================================
# EVENT MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file values into Vercel → Project → Settings → Environment Variables
# NEVER commit real secrets to GitHub.
# ============================================================

# ---------- REQUIRED for first deployment ----------

# Neon PostgreSQL (create free project at https://console.neon.tech)
# Use the "Pooled connection" string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Use the "Direct connection" string for migrations (unpooled)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# App URL (after first deploy, update with your real Vercel URL)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Auth secret (generate a long random string, e.g. openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- REQUIRED for email (Resend) ----------
# Create account + API key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"   # or your verified domain email
RESEND_FROM_NAME="SAMANVAYA 2027"

# ---------- OPTIONAL but recommended ----------

# Image storage (choose one provider)
# Option A: Uploadthing (https://uploadthing.com)
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""

# Option B: Cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ---------- OPTIONAL ----------
# NODE_ENV is set automatically by Vercel
